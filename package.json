{
  "name": "@lemonel/dsh-plugin-logs",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "lemonel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lemonel/dsh-plugin-logs.git"
  },
  "homepage": "https://github.com/lemonel/dsh-plugin-logs#readme",
  "bugs": {
    "url": "https://github.com/lemonel/dsh-plugin-logs/issues"
  },
  "keywords": ["dsh-plugin", "deepseek-harness", "logs", "debugging"],
  "description": "Right-sidebar viewer for in-memory Host Cordis logs, with filtering and opt-in Agent tools",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/backend_index.js",
    "./client": "./lib/client.js",
    "./typert": "./lib/typert.host.mjs",
    "./remote": "./lib/typert.remote-client.mjs",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./bundles/plugin-logs.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-api-session-controller"
      ],
      "external": []
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && node build.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "npm test",
    "check:package": "node test/tools/check-package.mjs",
    "check:clean": "node test/tools/verify-install.mjs",
    "check:compat": "node test/tools/compatibility-matrix.mjs",
    "prepack": "npm run build"
  },
  "files": [
    "icon.svg",
    "lib",
    "bundles",
    "README.md",
    "README.en.md",
    "RELEASING.md",
    "LICENSE",
    "docs",
    "screenshots.json"
  ],
  "engines": {
    "dsh": "0.2.0-rc.2 || 0.2.1-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent": "0.2.1-rc.1",
    "@deepseek-ai/dsh-api-gateway": "0.2.1-rc.1",
    "@deepseek-ai/dsh-session": "0.2.1-rc.1",
    "@deepseek-ai/dsh-typert-registry": "0.2.1-rc.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "esbuild": "^0.25.0",
    "jsdom": "^29.0.0",
    "react-dom": "^18.3.1",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-api-remotes": "0.2.0-rc.2 || 0.2.1-rc.1",
    "@deepseek-ai/dsh-api-session-controller": "0.2.0-rc.2 || 0.2.1-rc.1",
    "@deepseek-ai/dsh-client-locale": "0.2.0-rc.2 || 0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.0-rc.2 || 0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2 || 0.2.1-rc.1",
    "@deepseek-ai/dsh-scope": "0.2.0-rc.2 || 0.2.1-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2 || 0.2.1-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.2 || 0.2.1-rc.1",
    "@deepseek-ai/schemastery": "~3.18.4",
    "react": "^18.2.0"
  }
}
